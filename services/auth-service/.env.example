# Auth Service Environment Variables
# NOTE: These values are for LOCAL DEVELOPMENT (npm run dev).
# When running with Docker Compose, these values are OVERRIDDEN by docker-compose.yml.

# Server
PORT=4001
NODE_ENV=development

# Database (MySQL)
# Use 'localhost' for local dev, 'mysql' for docker
DB_HOST=localhost
DB_PORT=3307
DB_NAME=auth_service_db
DB_USER=root
DB_PASSWORD=Masaka224@

# Redis
# Use 'localhost' for local dev, 'redis' for docker
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=super-secret-jwt-key-for-financial-tracking-app-2024
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGIN=http://localhost:3000
