# Transaction Service Environment Variables
# NOTE: These values are for LOCAL DEVELOPMENT (npm run dev).
# When running with Docker Compose, these values are OVERRIDDEN by docker-compose.yml.

# Server
PORT=4002
NODE_ENV=development

# Database (MariaDB)
# Use 'localhost' for local dev, 'mariadb' for docker
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# JWT Configuration (Must match Auth Service)
JWT_SECRET=super-secret-jwt-key-for-financial-tracking-app-2026

# CORS
CORS_ORIGIN=http://localhost:3000
